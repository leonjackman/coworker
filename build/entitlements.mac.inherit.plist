<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Inherit parent app entitlements -->
  <key>com.apple.security.inherit</key>
  <true/>
  <!-- JIT is required for Electron/V8 on arm64 (hardened runtime) -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <!-- PyInstaller one-file backend self-extracts unsigned .so/.dylib at
       runtime (tiktoken, numpy, etc.); hardened runtime blocks loading them
       without this entitlement. -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
