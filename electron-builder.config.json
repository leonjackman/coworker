{
  "appId": "com.coworker.app",
  "productName": "Coworker",
  "directories": {
    "output": "release/"
  },
  "files": [
    "electron/**/*",
    "frontend/dist/**/*"
  ],
  "extraResources": [
    {
      "from": "backend/dist/pybackend",
      "to": "bin/pybackend"
    }
  ],
  "publish": {
    "provider": "github",
    "owner": "leonjackman",
    "repo": "coworker",
    "private": false,
    "releaseType": "release"
  },
  "mac": {
    "target": "dmg",
    "icon": "assets/brand/cw-icon-blue-white-background.png",
    "category": "public.app-category.developer-tools",
    "hardenedRuntime": false,
    "identity": "-"
  },
  "win": {
    "target": "nsis",
    "icon": "assets/brand/cw-icon-blue-white-background.png"
  },
  "linux": {
    "target": "AppImage",
    "icon": "assets/brand/cw-icon-blue-white-background.png"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartupShortcut": false
  }
}
