{
  "appId": "com.coworker.app",
  "productName": "CoWorker",
  "directories": {
    "output": "release/"
  },
  "files": [
    "electron/**/*",
    "!electron/cw-automa/**",
    "assets/**/*",
    "frontend/dist/**/*"
  ],
  "extraResources": [
    {
      "from": "backend/dist",
      "to": "bin",
      "filter": [
        "pybackend",
        "pybackend*"
      ]
    }
  ],
  "publish": {
    "provider": "github",
    "owner": "leonjackman",
    "repo": "coworker",
    "private": false,
    "releaseType": "release"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": false
  },
  "mac": {
    "artifactName": "${productName}-${version}-mac-${arch}.${ext}",
    "target": [
      {
        "target": "dmg",
        "arch": ["arm64"]
      },
      {
        "target": "zip",
        "arch": ["arm64"]
      }
    ],
    "icon": "assets/brand/png/cw-icon-blue-white-background.png",
    "category": "public.app-category.developer-tools",
    "hardenedRuntime": true,
    "entitlements": "build/entitlements.mac.plist",
    "entitlementsInherit": "build/entitlements.mac.inherit.plist",
    "extraResources": [
      {
        "from": "electron/cw-automa/build",
        "to": "cw-automa",
        "filter": [
          "cw-automa"
        ]
      }
    ]
  },
  "win": {
    "artifactName": "${productName}-${version}-win-${arch}.${ext}",
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ],
    "icon": "assets/brand/png/cw-icon-blue-white-background.png"
  },
  "linux": {
    "artifactName": "${productName}-${version}-linux-${arch}.${ext}",
    "target": [
      {
        "target": "AppImage",
        "arch": ["x64", "arm64"]
      },
      {
        "target": "deb",
        "arch": ["x64", "arm64"]
      }
    ],
    "icon": "assets/brand/png/cw-icon-blue-white-background.png"
  }
}
